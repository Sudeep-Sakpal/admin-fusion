# ---------------------------------------------------------------------
# Copy to .env for local development. NEVER commit a real .env.
# In production every value below must be set explicitly — the server
# refuses to boot with NODE_ENV=production if JWT_SECRET, MONGODB_URI or
# CORS_ORIGIN are missing (see src/config/env.ts).
# ---------------------------------------------------------------------

PORT=4000
NODE_ENV=development

# Exact frontend origin(s). Comma-separated for multiple (e.g. Vercel
# preview deployments). Must never be "*" — credentials are enabled.
CORS_ORIGIN=http://localhost:3000
# CORS_ORIGIN=https://your-app.vercel.app,https://your-app-preview.vercel.app

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hackathon

BCRYPT_SALT_ROUNDS=10

# Minimum 32 characters in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN_SECONDS=86400

# Defaults to true in production (Render fronts the service with its own
# proxy). Set to false only if the app receives connections directly.
# TRUST_PROXY=true

# Required ONLY to run the destructive seed script against a production
# database. Leave unset. `npm run seed` deletes all users, teams, tracks
# and problem statements.
# ALLOW_DESTRUCTIVE_SEED=true
